# Database: postgres://... in prod, pglite://<dir> or unset (= pglite://.pglite) on dev boxes
DATABASE_URL=
BETTER_AUTH_SECRET=change-me-32-bytes
PLATFORM_URL=http://localhost:3000
BOXES_DOMAIN=boxes.localhost
COOKIE_DOMAIN=
ADMIN_EMAILS=you@example.org
# Email: unset RESEND_API_KEY prints codes to the console
RESEND_API_KEY=
EMAIL_FROM=Alversjö <no-reply@notifications.alversjo.land>
# Fly
FLY_API_TOKEN=
FLY_BOXES_APP=alversjo-boxes
BOX_IMAGE=registry.fly.io/alversjo-boxes:latest
# Tokens injected into boxes
BOX_CLAUDE_TOKEN=
BOX_GH_TOKEN_ADMIN=
BOX_GH_TOKEN_CONTRIBUTOR=
CLOUDFLARE_API_TOKEN=
